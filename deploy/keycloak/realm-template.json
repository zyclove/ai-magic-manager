{
  "realm": "ai-manager",
  "enabled": true,
  "displayName": "智能管家",
  "loginTheme": "ai-manager",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "internationalizationEnabled": true,
  "supportedLocales": ["zh-CN", "en"],
  "defaultLocale": "zh-CN",
  "roles": {"realm": [
    {"name": "tenant-creator", "description": "Approved adult workspace creator"},
    {"name": "catalog-operator", "description": "Platform commercial catalog draft operator"},
    {"name": "catalog-approver", "description": "Independent platform commercial catalog approver"},
    {"name": "contract-operator", "description": "Platform institution contract evidence operator"},
    {"name": "contract-approver", "description": "Independent institution contract approver"}
  ]},
  "clientScopes": [
    {"name": "tenant:create", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}},
    {"name": "catalog:manage", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}},
    {"name": "catalog:approve", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}},
    {"name": "contract:manage", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}},
    {"name": "contract:approve", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}},
    {"name": "basic", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "false"}, "protocolMappers": [
      {"name": "subject", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "config": {"access.token.claim": "true", "id.token.claim": "true"}},
      {"name": "auth_time", "protocol": "openid-connect", "protocolMapper": "oidc-usersessionmodel-note-mapper", "config": {"user.session.note": "AUTH_TIME", "claim.name": "auth_time", "jsonType.label": "long", "access.token.claim": "true", "id.token.claim": "true"}}
    ]},
    {"name": "profile", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}, "protocolMappers": [
      {"name": "full name", "protocol": "openid-connect", "protocolMapper": "oidc-full-name-mapper", "config": {"access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}},
      {"name": "username", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper", "config": {"user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true"}}
    ]},
    {"name": "email", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}, "protocolMappers": [
      {"name": "email", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper", "config": {"user.attribute": "email", "claim.name": "email", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}},
      {"name": "email verified", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper", "config": {"user.attribute": "emailVerified", "claim.name": "email_verified", "jsonType.label": "boolean", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}}
    ]}
  ],
  "scopeMappings": [
    {"clientScope": "tenant:create", "roles": ["tenant-creator"]},
    {"clientScope": "catalog:manage", "roles": ["catalog-operator"]},
    {"clientScope": "catalog:approve", "roles": ["catalog-approver"]},
    {"clientScope": "contract:manage", "roles": ["contract-operator"]},
    {"clientScope": "contract:approve", "roles": ["contract-approver"]}
  ],
  "clients": [{
    "clientId": "ai-manager-guardian", "name": "智能管家管理端", "protocol": "openid-connect", "enabled": true,
    "publicClient": true, "standardFlowEnabled": true, "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false, "fullScopeAllowed": false,
    "redirectUris": ["http://localhost:18090/auth/callback"], "webOrigins": ["http://localhost:18090"],
    "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:18090/"},
    "defaultClientScopes": ["basic", "profile", "email", "tenant:create", "catalog:manage", "catalog:approve", "contract:manage", "contract:approve"],
    "protocolMappers": [
      {"name": "API audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": {"included.custom.audience": "ai-manager-api", "access.token.claim": "true", "id.token.claim": "false"}},
      {"name": "Authentication methods", "protocol": "openid-connect", "protocolMapper": "oidc-amr-mapper", "config": {"access.token.claim": "true", "id.token.claim": "true"}}
    ]
  }],
  "browserFlow": "manager-browser",
  "authenticatorConfig": [
    {"alias": "manager-pwd-reference", "config": {"default.reference.value": "pwd", "default.reference.maxAge": "300"}},
    {"alias": "manager-otp-reference", "config": {"default.reference.value": "otp", "default.reference.maxAge": "300"}}
  ],
  "authenticationFlows": [
    {"alias": "manager-browser", "providerId": "basic-flow", "topLevel": true, "builtIn": false, "authenticationExecutions": [
      {"authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "authenticatorFlow": false},
      {"flowAlias": "manager-forms", "requirement": "ALTERNATIVE", "priority": 20, "authenticatorFlow": true}
    ]},
    {"alias": "manager-forms", "providerId": "basic-flow", "topLevel": false, "builtIn": false, "authenticationExecutions": [
      {"authenticator": "auth-username-password-form", "authenticatorConfig": "manager-pwd-reference", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false},
      {"flowAlias": "manager-conditional-otp", "requirement": "CONDITIONAL", "priority": 20, "authenticatorFlow": true}
    ]},
    {"alias": "manager-conditional-otp", "providerId": "basic-flow", "topLevel": false, "builtIn": false, "authenticationExecutions": [
      {"authenticator": "conditional-user-configured", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false},
      {"authenticator": "auth-otp-form", "authenticatorConfig": "manager-otp-reference", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": false}
    ]}
  ]
}
