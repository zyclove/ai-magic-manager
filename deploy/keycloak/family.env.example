# Non-secret configuration only. -ConsumerIdentity initialization writes these disabled defaults.
# Provider credentials belong in restricted DEPLOYMENT_ROOT/secrets files, never this environment file.
CONSUMER_PHONE_ENABLED=false
CONSUMER_WECHAT_ENABLED=false
# Enable only after isolated SMS/WeChat recovery and current-session checks pass.
FAMILY_ACCOUNT_SECURITY_ENABLED=false
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
WECHAT_NATIVE_APP_ID=
FAMILY_AI_ENABLED=false
FAMILY_AI_MODEL=
FAMILY_PUSH_ENABLED=false
FAMILY_PUSH_WORKER_ENABLED=false
FAMILY_WECHAT_ENABLED=false
FAMILY_COMMERCE_WORKER_ENABLED=false
FAMILY_BILLS_WORKER_ENABLED=false
FAMILY_SALES_ENABLED=false
FAMILY_WECHAT_APP_ID=
FAMILY_WECHAT_MERCHANT_ID=
FAMILY_WECHAT_MERCHANT_SERIAL=
FAMILY_WECHAT_PLATFORM_KEY_ID=
FAMILY_WECHAT_NOTIFY_URL=
FAMILY_ACCEPTANCE_ENABLED=false
