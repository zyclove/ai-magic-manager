# Non-secret example. scripts/initialize-deployment.ps1 creates absolute paths.
# Passwords and private keys are read from DEPLOYMENT_ROOT/secrets, never .env.
COMPOSE_PROJECT_NAME=ai-manager-repro
REPOSITORY_ROOT=/absolute/path/ai-manager
DEPLOYMENT_ROOT=/absolute/path/ai-manager/.local/deployment
BACKEND_BUILD_CONTEXT=/absolute/path/ai-manager/.local/deployment/artifacts/backend
GUARDIAN_BUILD_CONTEXT=/absolute/path/ai-manager/.local/deployment/artifacts/guardian
PUBLIC_URL=http://localhost:18090
EDGE_PORT=18090
EDGE_BIND_ADDRESS=127.0.0.1
APP_UID=10001
APP_GID=10001
MYSQL_IMAGE=mysql:8.4.11@sha256:6ea90827b1100f8f2ae306a539f86d2c264a26ed435a2a9f75551dd5c3aeb242
KEYCLOAK_BASE_IMAGE=quay.io/keycloak/keycloak:26.8.0@sha256:b0f60d489d51c5d113390bdf5461d4c06e6051be026c05549f2e1e10ec352bcc
JAVA_RUNTIME_IMAGE=eclipse-temurin:17-jre-alpine@sha256:3c472129dc75a8d1d7a3f2df5b2093a8077e4493deff046754d4764d0371de63
EDGE_BASE_IMAGE=nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
BACKEND_IMAGE=ai-manager/backend:repro
IDENTITY_IMAGE=ai-manager/identity:repro
EDGE_IMAGE=ai-manager/edge:repro
